<%@ Page Title="Daak Scanned Pages" Language="C#" MasterPageFile="~/DSM.Master" AutoEventWireup="true" CodeBehind="DaakDocuments.aspx.cs" Inherits="DigitalSchoolManager.DaakDocuments" %>
<asp:Content ID="DaakDocs" ContentPlaceHolderID="MainContent" runat="server">
<div class="daak-docs-page"><section class="daak-docs-hero"><div><span>Database Document Archive</span><h1><asp:Label ID="lblRegisterTitle" runat="server" /></h1><p><asp:Label ID="lblRecordSummary" runat="server" /></p></div><a class="daak-docs-back" href="javascript:history.back()">Back to register</a></section>
<asp:Panel ID="pnlMessage" runat="server" Visible="false" CssClass="daak-docs-message"><asp:Label ID="lblMessage" runat="server" /></asp:Panel>
<section class="daak-docs-card"><div><span class="daak-docs-kicker">Add pages</span><h2>Upload scanned pages or PDF copies</h2><p>Select several files together. Images are automatically optimized below 1 MB; each PDF may be up to 5 MB.</p></div><div class="daak-docs-upload"><asp:FileUpload ID="fuDocuments" runat="server" AllowMultiple="true" accept=".jpg,.jpeg,.png,.gif,.bmp,.pdf" CssClass="office-daak-file-control" /><asp:Button ID="btnUpload" runat="server" Text="Upload Selected Pages" CssClass="office-daak-button office-daak-button-primary" OnClick="btnUpload_Click" /></div></section>
<section class="daak-docs-card"><div><span class="daak-docs-kicker">Permanent copies</span><h2>Archived document pages</h2></div><asp:GridView ID="gvDocuments" runat="server" AutoGenerateColumns="false" CssClass="daak-docs-grid" GridLines="None" EmptyDataText="No scanned pages or PDF copies have been uploaded." OnRowCommand="gvDocuments_RowCommand"><Columns><asp:BoundField DataField="SequenceNo" HeaderText="Page" /><asp:BoundField DataField="OriginalFileName" HeaderText="File" /><asp:BoundField DataField="FileContentType" HeaderText="Type" /><asp:TemplateField HeaderText="Size"><ItemTemplate><%# FormatSize(Eval("FileSizeBytes")) %></ItemTemplate></asp:TemplateField><asp:BoundField DataField="UploadedAtUtc" HeaderText="Uploaded" DataFormatString="{0:dd MMM yyyy, hh:mm tt}" /><asp:TemplateField HeaderText="Actions"><ItemTemplate><a class="daak-doc-action view" target="_blank" href='<%# "DaakAttachment.ashx?id="+Eval("DocumentID") %>'>View</a><a class="daak-doc-action download" href='<%# "DaakAttachment.ashx?id="+Eval("DocumentID")+"&download=1" %>'>Download</a><asp:LinkButton ID="btnDelete" runat="server" Text="Delete" CssClass="daak-doc-action delete" CommandName="DeleteDocument" CommandArgument='<%# Eval("DocumentID") %>' CausesValidation="false" OnClientClick="return confirm('Delete this scanned page permanently?');" /></ItemTemplate></asp:TemplateField></Columns></asp:GridView></section></div>
</asp:Content>
